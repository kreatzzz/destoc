# PostgreSQL / Prisma
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/destoc"
PORT="3000"
NEXT_PUBLIC_SHOW_AGENTATION="true"

# Better Auth (generate with: openssl rand -base64 32)
BETTER_AUTH_SECRET="replace-with-a-minimum-32-character-secret"
BETTER_AUTH_URL="http://localhost:3000"

# Optional. Required in production for distributed rate limiting.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
ALLOW_IN_MEMORY_RATE_LIMIT="false"

# Required to execute public repositories in Vercel Sandbox. These credentials
# stay in the host function and are never passed into an imported repository.
VERCEL_TOKEN=""
VERCEL_TEAM_ID=""
VERCEL_PROJECT_ID=""

# Optional. Required when screenshot assets are persisted to Vercel Blob.
BLOB_READ_WRITE_TOKEN=""

# Provider selection. Use "mock" for deterministic free local testing, "local"
# for an OpenAI-compatible local/proxy endpoint, "command" for an explicit
# local command bridge, or "deepseek" once wired.
DESIGN_REVIEW_PROVIDER="mock"
DEEPSEEK_API_KEY=""
LOCAL_AI_BASE_URL="http://localhost:11434/v1"
LOCAL_AI_API_KEY=""
LOCAL_AI_MODEL="local-model"
COMMAND_AI_BIN="codex"
COMMAND_AI_ARGS='["exec","--model","gpt-5.4","-c","model_reasoning_effort=\"medium\"","--sandbox","read-only","--color","never","--ephemeral","-"]'
COMMAND_AI_TIMEOUT_MS="120000"
ALLOW_COMMAND_REVIEW_PROVIDER="false"

# Seed-only credentials. Use different values outside local development.
DEMO_EMAIL="demo@destoc.local"
DEMO_PASSWORD="DemoPassword123!"
